NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false
WEB_ORIGIN=http://localhost:3000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
API_URL=http://localhost:3001
DATABASE_URL=postgresql://harmofin_local:harmofin_local@localhost:5432/harmofin
POSTGRES_PORT=5432
POSTGRES_DB=harmofin
POSTGRES_USER=harmofin_local
POSTGRES_PASSWORD=harmofin_local
AUTH_TOKEN_HASH_SECRET=local-only-change-this-secret-32-bytes-minimum
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_PORT=8025
MAIL_FROM=no-reply@harmofin.local
WEB_BASE_URL=http://localhost:3000
# Telegram-бот (необязательно). Без токена канал Telegram выключен. Локально webhook не регистрируется.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Push-уведомления (необязательно). Ключи: pnpm --filter @harmofin/worker exec web-push generate-vapid-keys --json
# Публичный ключ нужен API и воркеру, приватный ключ и VAPID_SUBJECT — только воркеру. Пустые значения выключают push.
# Локально push проверяется только на собранном приложении: service worker в pnpm dev не регистрируется.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SEED_DEMO_PASSWORD=local-demo-password-10

# Реквизиты оператора ПД для /privacy, /terms, /consent. В production обязательны.
NUXT_PUBLIC_LEGAL_OPERATOR_NAME=
NUXT_PUBLIC_LEGAL_OPERATOR_INN=
NUXT_PUBLIC_LEGAL_OPERATOR_EMAIL=
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
NUXT_PUBLIC_LEGAL_EMAIL_PROVIDER=

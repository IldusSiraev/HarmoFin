{
  "name": "@harmofin/api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:seed": "tsx ../../prisma/seed/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "fastify": "5.12.5",
    "nodemailer": "10.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@harmofin/eslint-config": "workspace:*",
    "@harmofin/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "prisma": "6.19.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

{
  "name": "@harmofin/worker",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "pino": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@harmofin/eslint-config": "workspace:*",
    "@harmofin/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

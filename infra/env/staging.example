CADDY_IMAGE=<registry-caddy-image>@sha256:<digest>
CADDY_SITE_ADDRESS=<environment-domain>
HTTP_PORT=80
HTTPS_PORT=443
WEB_IMAGE=<registry-web-image>
API_IMAGE=<registry-api-image>
WORKER_IMAGE=<registry-worker-image>
MIGRATE_IMAGE=<registry-migrate-image>
IMAGE_TAG=<commit-sha>
NUXT_PUBLIC_API_URL=https://<environment-domain>
# Реквизиты оператора ПД для /privacy, /terms, /consent. В production обязательны.
NUXT_PUBLIC_LEGAL_OPERATOR_NAME=
NUXT_PUBLIC_LEGAL_OPERATOR_INN=
NUXT_PUBLIC_LEGAL_OPERATOR_EMAIL=
NUXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
NUXT_PUBLIC_LEGAL_EMAIL_PROVIDER=
DATABASE_URL=<provided-at-runtime>
POSTGRES_DB=<provided-at-runtime>
POSTGRES_USER=<provided-at-runtime>
POSTGRES_PASSWORD=<provided-at-runtime>
WEB_ORIGIN=https://<environment-domain>
AUTH_TOKEN_HASH_SECRET=<provided-at-runtime>
SMTP_HOST=<provided-at-runtime>
SMTP_PORT=587
SMTP_USER=<provided-at-runtime>
SMTP_PASSWORD=<provided-at-runtime>
MAIL_FROM=<provided-at-runtime>
WEB_BASE_URL=https://<environment-domain>
LOG_LEVEL=info
TRUST_PROXY=true
ERROR_REPORTING_ENDPOINT=<optional-error-reporting-endpoint>
OTEL_EXPORTER_OTLP_ENDPOINT=<optional-otlp-endpoint>
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002
WORKER_POLL_INTERVAL_MS=30000
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=300
COMPOSE_PROJECT_NAME=harmofin-staging
SMOKE_BASE_URL=https://<environment-domain>

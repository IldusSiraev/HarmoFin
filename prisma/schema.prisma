generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  PENDING_DELETION
  DELETED
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ALL_SESSIONS_REVOKED
  ROTATED
  ADMIN_REVOKED
  ACCOUNT_DELETED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceMembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum AccountType {
  BANK_ACCOUNT
  BANK_CARD
  CASH
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum EnvelopeType {
  CURRENT_EXPENSES
  MANDATORY_EXPENSES
  SAVINGS_GOAL
  RESERVE
  FREE_MONEY
  CUSTOM
}

enum PeriodSlot {
  FIRST
  SECOND
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  DELETED
}

enum IncomeAllocationStatus {
  CONFIRMED
  CANCELLED
  DELETED
}

enum TransferStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  DELETED
}

enum TransferMode {
  LEGACY_PARTS
  ACCOUNT_ONLY
}

enum EnvelopeReallocationStatus {
  CONFIRMED
  DELETED
}

enum EnvelopeAssignmentType {
  INCOME
  OPENING
  FREE
}

enum EnvelopeLedgerStatus {
  CONFIRMED
  DELETED
}

enum TargetStatus {
  UNSET
  DRAFT
  CONFIRMED
}

enum FundingRuleType {
  MANUAL
  SUM_OF_PLANS
  FIXED_PER_PERIOD
  SUGGESTED_FIXED
  PERCENT_OF_INCOME
}

enum RegularPlanType {
  INCOME
  EXPENSE
  SAVINGS
}

enum PlanRecurrence {
  ONE_TIME
  MONTHLY
  EVERY_N_MONTHS
  YEARLY
}

enum PlanOccurrenceStatus {
  PENDING
  DUE
  SKIPPED
  COMPLETED
  CANCELLED
}

enum PlanOccurrenceCancellationReason {
  PLAN_CHANGED
  PLAN_DISABLED
  PLAN_DELETED
}

enum WorkerJobType {
  MATERIALIZE_PLAN_OCCURRENCES
  EVALUATE_BUDGET_NOTIFICATIONS
  PURGE_DELETED_ACCOUNTS
  EVALUATE_CALENDAR_REMINDERS
}

enum WorkerJobStatus {
  PENDING
  RUNNING
  FAILED
}

enum NotificationType {
  PLAN_UPCOMING
  PLAN_TODAY
  PLAN_OVERDUE
  UNALLOCATED_INCOME
  NEGATIVE_ACCOUNT
  NEGATIVE_ENVELOPE
  INSUFFICIENT_MANDATORY_OBLIGATIONS
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  OBJECTS_TRANSFERRED
  CALENDAR_REMINDER
}

enum LegalDocumentType {
  TERMS
  PRIVACY_POLICY
  PD_CONSENT
}

model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar(512)
  displayName     String?    @map("display_name") @db.VarChar(120)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  memberships        WorkspaceMembership[]
  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  recoveryTokens     RecoveryToken[]
  auditEvents          AuditEvent[]          @relation("AuditActor")
  idempotencyRecords   IdempotencyRecord[]
  createdRegularPlans  RegularPlan[]          @relation("RegularPlanCreator")
  updatedRegularPlans  RegularPlan[]          @relation("RegularPlanUpdater")
  actedPlanOccurrences PlanOccurrence[]       @relation("PlanOccurrenceActor")
  notifications        Notification[]
  consents             UserConsent[]
  sentInvitations     WorkspaceInvitation[] @relation("InvitationInviter")
  acceptedInvitations WorkspaceInvitation[] @relation("InvitationAcceptor")
  ownedAccounts        Account[]            @relation("AccountOwner")
  ownedEnvelopes       Envelope[]           @relation("EnvelopeOwner")
  ownedRegularPlans    RegularPlan[]        @relation("RegularPlanOwner")
  createdAssignments   EnvelopeAssignment[] @relation("EnvelopeAssignmentCreator")
  createdMovements     EnvelopeMovement[]   @relation("EnvelopeMovementCreator")
  calendarEventsCreated       CalendarEvent[]            @relation("CalendarEventAuthor")
  calendarEventParticipations CalendarEventParticipant[] @relation("CalendarEventParticipantUser")
  activityFeedCursors         ActivityFeedCursor[]       @relation("ActivityFeedCursorUser")

  @@map("users")
}

model Session {
  id               String              @id @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  tokenHash        String              @unique @map("token_hash") @db.Char(64)
  csrfTokenHash    String              @unique @map("csrf_token_hash") @db.Char(64)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt    DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime           @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  userAgent        String?             @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, idleExpiresAt])
  @@index([userId, absoluteExpiresAt])
  @@map("sessions")
}

model Workspace {
  id          String          @id @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  name        String          @db.VarChar(120)
  timezone    String          @default("Europe/Moscow") @db.VarChar(64)
  status      WorkspaceStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships  WorkspaceMembership[]
  budgets      Budget[]
  auditEvents  AuditEvent[]
  regularPlans RegularPlan[]
  occurrences  PlanOccurrence[]
  notifications Notification[]
  invitations   WorkspaceInvitation[]
  calendarEvents CalendarEvent[]
  activityFeedCursors ActivityFeedCursor[]

  @@index([ownerId, status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                  @id @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  role        WorkspaceMembershipRole
  isActive    Boolean                 @default(true) @map("is_active")
  removedAt   DateTime?               @map("removed_at") @db.Timestamptz(3)
  lastSelectedAt DateTime?            @map("last_selected_at") @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
  @@index([workspaceId, isActive])
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id               String                    @id @db.Uuid
  workspaceId      String                    @map("workspace_id") @db.Uuid
  email            String                    @db.VarChar(320)
  role             WorkspaceMembershipRole
  tokenHash        String                    @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime                  @map("expires_at") @db.Timestamptz(3)
  status           WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId  String                    @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?                   @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?                 @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime?                 @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy  User      @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedBy User?     @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([workspaceId, status])
  @@map("workspace_invitations")
}

model Budget {
  id                               String       @id @db.Uuid
  workspaceId                      String       @map("workspace_id") @db.Uuid
  name                             String       @db.VarChar(120)
  primaryCurrency                  String       @default("RUB") @map("primary_currency") @db.Char(3)
  cycleStartDay                    Int          @default(1) @map("cycle_start_day") @db.SmallInt
  periodBoundaryOffset             Int          @default(15) @map("period_boundary_offset") @db.SmallInt
  allowNegativeBalance             Boolean      @default(false) @map("allow_negative_balance")
  timezone                         String       @default("Europe/Moscow") @db.VarChar(64)
  incomeAllocationRuleEnabled      Boolean      @default(false) @map("income_allocation_rule_enabled")
  incomeAllocationSourceCategoryId String?      @map("income_allocation_source_category_id") @db.Uuid
  incomeAllocationTargetEnvelopeId String?      @map("income_allocation_target_envelope_id") @db.Uuid
  status                           BudgetStatus @default(ACTIVE)
  planModelVersion                 Int          @default(2) @map("plan_model_version")
  planModelActivatedOn             DateTime?    @map("plan_model_activated_on") @db.Date
  onboardingNoMandatoryPlansAt     DateTime?    @map("onboarding_no_mandatory_plans_at") @db.Timestamptz(3)
  createdAt                        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditEvents        AuditEvent[]
  accounts           Account[]
  categories         Category[]
  envelopes          Envelope[]
  transactions       Transaction[]
  incomeAllocations  IncomeAllocation[]
  transfers          Transfer[]
    envelopeReallocations EnvelopeReallocation[]
    envelopePeriods      EnvelopePeriod[]
    envelopeFundingRules EnvelopeFundingRule[]
    envelopeAssignments   EnvelopeAssignment[]
    envelopeMovements     EnvelopeMovement[]
    budgetCycleRevisions BudgetCycleRevision[]
    idempotencyRecords IdempotencyRecord[]
    regularPlans       RegularPlan[]
    occurrences        PlanOccurrence[]
    planPayments       PlanPayment[]
    notifications      Notification[]
    calendarEvents     CalendarEvent[]
    activityFeedCursors ActivityFeedCursor[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("budgets")
}

model Account {
  id                   String      @id @db.Uuid
  budgetId             String      @map("budget_id") @db.Uuid
  ownerUserId          String      @map("owner_user_id") @db.Uuid
  name                 String      @db.VarChar(120)
  accountType          AccountType @map("account_type")
  bankName             String?     @map("bank_name") @db.VarChar(120)
  lastFourDigits       String?     @map("last_four_digits") @db.Char(4)
  currency             String      @default("RUB") @db.Char(3)
  scale                Int         @default(2) @db.SmallInt
  startingBalanceMinor BigInt      @map("starting_balance_minor")
  accountingStartDate  DateTime    @map("accounting_start_date") @db.Date
  comment              String?     @db.VarChar(500)
  archivedAt           DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget                     Budget             @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner                      User               @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions               Transaction[]
  incomeAllocations          IncomeAllocation[]
  transferPartsAsSource      TransferPart[]     @relation("TransferPartSourceAccount")
  transferPartsAsDestination TransferPart[]     @relation("TransferPartDestinationAccount")
  directTransfersAsSource    Transfer[]         @relation("TransferSourceAccount")
  directTransfersAsDestination Transfer[]       @relation("TransferDestinationAccount")
  regularPlans               RegularPlan[]      @relation("RegularPlanDefaultAccount")
  occurrenceSnapshots        PlanOccurrence[]   @relation("PlanOccurrenceDefaultAccount")

  @@unique([id, budgetId])
  @@index([budgetId, archivedAt])
  @@index([budgetId, ownerUserId])
  @@map("accounts")
}

model Category {
  id           String       @id @db.Uuid
  budgetId     String       @map("budget_id") @db.Uuid
  templateKey  String?      @map("template_key") @db.VarChar(80)
  name         String       @db.VarChar(120)
  categoryType CategoryType @map("category_type")
  parentId     String?      @map("parent_id") @db.Uuid
  displayOrder Int          @map("display_order")
  comment      String?      @db.VarChar(500)
  icon         String?      @db.VarChar(40)
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent       Category?     @relation("CategoryParent", fields: [parentId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  children            Category[]       @relation("CategoryParent")
  transactions        Transaction[]
  regularPlans        RegularPlan[]     @relation("RegularPlanCategory")
  occurrenceSnapshots PlanOccurrence[]  @relation("PlanOccurrenceCategory")

  @@unique([id, budgetId])
  @@index([budgetId, categoryType, archivedAt])
  @@map("categories")
}

model Envelope {
  id                        String       @id @db.Uuid
  budgetId                  String       @map("budget_id") @db.Uuid
  ownerUserId               String       @map("owner_user_id") @db.Uuid
  templateKey               String?      @map("template_key") @db.VarChar(80)
  name                      String       @db.VarChar(120)
  envelopeType              EnvelopeType @map("envelope_type")
  currency                  String       @default("RUB") @db.Char(3)
  scale                     Int          @default(2) @db.SmallInt
  startingBalanceMinor      BigInt       @map("starting_balance_minor")
  monthlyPlannedAmountMinor BigInt?      @map("monthly_planned_amount_minor")
  targetAmountMinor         BigInt?      @map("target_amount_minor")
  targetDate                DateTime?    @map("target_date") @db.Date
  periodSlot                PeriodSlot?  @map("period_slot")
  displayOrder              Int          @map("display_order")
  comment                   String?      @db.VarChar(500)
  archivedAt                DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget                     Budget             @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner                      User               @relation("EnvelopeOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions               Transaction[]
  incomeAllocations          IncomeAllocation[]
  transferPartsAsSource      TransferPart[]        @relation("TransferPartSourceEnvelope")
  transferPartsAsDestination TransferPart[]        @relation("TransferPartDestinationEnvelope")
  envelopeReallocationsAsSource      EnvelopeReallocation[] @relation("EnvelopeReallocationSource")
  envelopeReallocationsAsDestination EnvelopeReallocation[] @relation("EnvelopeReallocationDestination")
  envelopePeriods            EnvelopePeriod[]      @relation("EnvelopePeriodEnvelope")
  envelopeFundingRules       EnvelopeFundingRule[] @relation("EnvelopeFundingRuleEnvelope")
  regularPlans               RegularPlan[]         @relation("RegularPlanEnvelope")
  occurrenceSnapshots        PlanOccurrence[]      @relation("PlanOccurrenceEnvelope")
  envelopeAssignments        EnvelopeAssignment[]
  movementsAsSource          EnvelopeMovement[]  @relation("MovementSourceEnvelope")
  movementsAsDestination     EnvelopeMovement[]  @relation("MovementDestinationEnvelope")

  @@unique([id, budgetId])
  @@index([budgetId, archivedAt])
  @@index([budgetId, ownerUserId])
  @@map("envelopes")
}

model Transaction {
  id                String            @id @db.Uuid
  budgetId          String            @map("budget_id") @db.Uuid
  transactionType   TransactionType   @map("transaction_type")
  status            TransactionStatus @default(DRAFT)
  accountingModelVersion Int          @default(1) @map("accounting_model_version")
  amountMinor       BigInt            @map("amount_minor")
  currency          String            @default("RUB") @db.Char(3)
  scale             Int               @default(2) @db.SmallInt
  occurredOn        DateTime          @map("occurred_on") @db.Date
  accountId         String            @map("account_id") @db.Uuid
  categoryId        String            @map("category_id") @db.Uuid
  envelopeId        String?           @map("envelope_id") @db.Uuid
  sourceDescription String?           @map("source_description") @db.VarChar(250)
  merchantName      String?           @map("merchant_name") @db.VarChar(250)
  isPlanned         Boolean           @default(false) @map("is_planned")
  comment           String?           @db.VarChar(500)
  confirmedAt       DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  preDeleteStatus   TransactionStatus? @map("pre_delete_status")
  createdByUserId   String            @map("created_by_user_id") @db.Uuid
  updatedByUserId   String            @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account     Account            @relation(fields: [accountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  category    Category           @relation(fields: [categoryId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  envelope       Envelope?          @relation(fields: [envelopeId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  allocations    IncomeAllocation[]
  envelopeAssignments EnvelopeAssignment[]
  planOccurrence PlanOccurrence?    @relation("PlanOccurrenceTransaction")
  planPayments   PlanPayment[]      @relation("PlanPaymentTransaction")

  @@unique([id, budgetId])
  @@index([budgetId, occurredOn, createdAt])
  @@index([budgetId, transactionType, status, occurredOn])
  @@index([budgetId, accountId, occurredOn])
  @@index([budgetId, categoryId, occurredOn])
  @@index([budgetId, envelopeId, occurredOn])
  @@map("transactions")
}

model IncomeAllocation {
  id                  String                 @id @db.Uuid
  budgetId            String                 @map("budget_id") @db.Uuid
  incomeTransactionId String                 @map("income_transaction_id") @db.Uuid
  status              IncomeAllocationStatus @default(CONFIRMED)
  amountMinor         BigInt                 @map("amount_minor")
  currency            String                 @default("RUB") @db.Char(3)
  scale               Int                    @default(2) @db.SmallInt
  occurredOn          DateTime               @map("occurred_on") @db.Date
  accountId           String                 @map("account_id") @db.Uuid
  envelopeId          String                 @map("envelope_id") @db.Uuid
  comment             String?                @db.VarChar(500)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(3)
  preDeleteStatus     IncomeAllocationStatus? @map("pre_delete_status")
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  updatedByUserId     String                 @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget            Budget      @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  incomeTransaction Transaction @relation(fields: [incomeTransactionId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  account           Account     @relation(fields: [accountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  envelope          Envelope    @relation(fields: [envelopeId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, budgetId])
  @@index([budgetId, incomeTransactionId, status])
  @@index([budgetId, envelopeId, occurredOn])
  @@map("income_allocations")
}

model Transfer {
  id                 String         @id @db.Uuid
  budgetId           String         @map("budget_id") @db.Uuid
  status             TransferStatus @default(DRAFT)
  mode               TransferMode   @default(LEGACY_PARTS)
  totalMinor         BigInt         @map("total_minor")
  currency           String         @default("RUB") @map("currency") @db.Char(3)
  scale              Int            @default(2) @db.SmallInt
  occurredOn         DateTime       @map("occurred_on") @db.Date
  comment            String?        @db.VarChar(500)
  confirmedAt        DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(3)
  sourceAccountId    String?        @map("source_account_id") @db.Uuid
  destinationAccountId String?      @map("destination_account_id") @db.Uuid
  createdByUserId    String         @map("created_by_user_id") @db.Uuid
  updatedByUserId    String         @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  budget             Budget         @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parts              TransferPart[]
  sourceAccount      Account?       @relation("TransferSourceAccount", fields: [sourceAccountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  destinationAccount Account?       @relation("TransferDestinationAccount", fields: [destinationAccountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, budgetId])
  @@index([budgetId, occurredOn, createdAt])
  @@index([budgetId, status, occurredOn])
  @@index([budgetId, sourceAccountId])
  @@index([budgetId, destinationAccountId])
  @@map("transfers")
}

model TransferPart {
  id                    String   @id @db.Uuid
  transferId            String   @map("transfer_id") @db.Uuid
  budgetId              String   @map("budget_id") @db.Uuid
  sourceAccountId       String   @map("source_account_id") @db.Uuid
  destinationAccountId  String   @map("destination_account_id") @db.Uuid
  sourceEnvelopeId      String   @map("source_envelope_id") @db.Uuid
  destinationEnvelopeId String   @map("destination_envelope_id") @db.Uuid
  amountMinor           BigInt   @map("amount_minor")
  comment               String?  @db.VarChar(500)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transfer            Transfer @relation(fields: [transferId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  sourceAccount       Account  @relation("TransferPartSourceAccount", fields: [sourceAccountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)
  destinationAccount  Account  @relation("TransferPartDestinationAccount", fields: [destinationAccountId, budgetId], references: [id, budgetId], onDelete: Restrict, onUpdate: Cascade)

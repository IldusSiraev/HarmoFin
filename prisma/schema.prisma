  userId                   String    @map("user_id") @db.Uuid
  requestedAt              DateTime  @map("requested_at") @db.Timestamptz(3)
  purgeAfter               DateTime  @map("purge_after") @db.Timestamptz(3)
  restoreTokenHash         String    @unique @map("restore_token_hash") @db.Char(64)
  archivedWorkspaceIds     String[]  @default([]) @map("archived_workspace_ids") @db.Uuid
  archivedBudgetIds        String[]  @default([]) @map("archived_budget_ids") @db.Uuid
  deactivatedMembershipIds String[]  @default([]) @map("deactivated_membership_ids") @db.Uuid
  restoredAt               DateTime? @map("restored_at") @db.Timestamptz(3)
  purgedAt                 DateTime? @map("purged_at") @db.Timestamptz(3)

  @@index([purgedAt, restoredAt, purgeAfter])
  @@index([userId])
  @@map("account_deletions")
}

// Append-only proof of consent (152-FZ art. 9 part 3): a new document version adds rows, never edits them.
model UserConsent {
  id         String            @id @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  document   LegalDocumentType
  version    String            @db.VarChar(32)
  acceptedAt DateTime          @map("accepted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, document, version])
  @@map("user_consents")
}

model AuditEvent {
  id           String    @id @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  workspaceId  String?   @map("workspace_id") @db.Uuid
  budgetId     String?   @map("budget_id") @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(64)
  entityId     String?   @map("entity_id") @db.Uuid
  action       String    @db.VarChar(64)
  oldValues    Json?     @map("old_values")
  newValues    Json?     @map("new_values")
  source       String    @db.VarChar(32)
  requestId    String?   @map("request_id") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budget   Budget?    @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([workspaceId, createdAt])
  @@index([budgetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

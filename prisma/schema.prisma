generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum SessionRevokeReason {
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ALL_SESSIONS_REVOKED
  ROTATED
  ADMIN_REVOKED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceMembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar(512)
  displayName     String?    @map("display_name") @db.VarChar(120)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  memberships      WorkspaceMembership[]
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  recoveryTokens   RecoveryToken[]
  auditEvents      AuditEvent[] @relation("AuditActor")

  @@map("users")
}

model Session {
  id               String              @id @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  tokenHash        String              @unique @map("token_hash") @db.Char(64)
  csrfTokenHash    String              @unique @map("csrf_token_hash") @db.Char(64)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt    DateTime            @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime           @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  userAgent        String?             @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, idleExpiresAt])
  @@index([userId, absoluteExpiresAt])
  @@map("sessions")
}

model Workspace {
  id          String          @id @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  name        String          @db.VarChar(120)
  timezone    String          @default("Europe/Moscow") @db.VarChar(64)
  status      WorkspaceStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships  WorkspaceMembership[]
  budgets      Budget[]
  auditEvents  AuditEvent[]

  @@index([ownerId, status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                  @id @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  role        WorkspaceMembershipRole
  isActive    Boolean                 @default(true) @map("is_active")
  removedAt   DateTime?               @map("removed_at") @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, isActive])
  @@index([workspaceId, isActive])
  @@map("workspace_memberships")
}

model Budget {
  id                    String       @id @db.Uuid
  workspaceId           String       @map("workspace_id") @db.Uuid
  name                  String       @db.VarChar(120)
  primaryCurrency       String       @default("RUB") @map("primary_currency") @db.Char(3)
  cycleStartDay         Int          @default(10) @map("cycle_start_day") @db.SmallInt
  periodBoundaryOffset  Int          @default(15) @map("period_boundary_offset") @db.SmallInt
  allowNegativeBalance  Boolean      @default(false) @map("allow_negative_balance")
  status                BudgetStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditEvents AuditEvent[]

  @@index([workspaceId, status])
  @@map("budgets")
}

model RecoveryToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("recovery_tokens")
}

model AuditEvent {
  id           String    @id @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  workspaceId  String?   @map("workspace_id") @db.Uuid
  budgetId     String?   @map("budget_id") @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(64)
  entityId     String?   @map("entity_id") @db.Uuid
  action       String    @db.VarChar(64)
  oldValues    Json?     @map("old_values")
  newValues    Json?     @map("new_values")
  source       String    @db.VarChar(32)
  requestId    String?   @map("request_id") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budget   Budget?    @relation(fields: [budgetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([workspaceId, createdAt])
  @@index([budgetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}
